# ============================================================
# .gitignore — bimbel-gemilang-app
# ============================================================
# 🔥 DIPERBAIKI (audit 2026-10-01): file ini sebelumnya RUSAK TOTAL.
# Isinya markdown code-fence (```gitignore ... ```), DUA blok gitignore
# yang saling menimpa (Python + React), dan bahkan teks meta AI
# ("Wait, let me reconsider...") yang ikut ter-commit.
#
# Kerusakan paling merugikan: blok kedua meng-ignore `public/`, padahal
# itu folder ASET APLIKASI (ikon PWA, bagan SVG materi). Akibatnya setiap
# aset baru wajib `git add -f` dan berulang kali "hilang" di mesin lain --
# sampai perlu dibuat skrip pengingat khusus (scripts/cek-aset-materi.mjs).
#
# Sekarang `public/` TIDAK di-ignore lagi, jadi aset materi ter-track
# normal tanpa perlu -f.
# ============================================================

# --- Dependensi ---
node_modules/
.pnp
.pnp.js

# --- Hasil build ---
dist/
dist-probe/
build/
out/
*.local

# --- Variabel lingkungan (JANGAN pernah commit secret) ---
.env
.env.*
!.env.example
*.env

# --- Log ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Cache tooling ---
.cache/
.eslintcache
.stylelintcache
.vite/
.turbo/
.parcel-cache/
coverage/
htmlcov/
.coverage
.coverage.*

# --- Python (dipakai sebagian skrip di scripts/) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editor & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Vercel ---
.vercel

# --- KREDENSIAL FIREBASE ADMIN (JANGAN PERNAH COMMIT) ---
# Service account key setara kunci master seluruh database.
# Diunduh dari Firebase Console -> Project settings -> Service accounts.
# Nama file bawaannya mirip: gemilangsystem-firebase-adminsdk-xxxxx.json
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*-firebase-adminsdk-*.json
google-credentials*.json
gcp-key*.json
credentials.json
secrets/

# --- File sementara ---
*.tmp
*.temp
*.bak
