# ============================================================
# .env.example — bimbel-gemilang-app
# ============================================================
# 🔥 BARU (audit 2026-10-01): repo ini butuh 20 variabel lingkungan
# untuk Vercel Functions di folder api/, tapi sebelumnya TIDAK ADA
# daftar sama sekali. Developer baru tidak punya cara tahu apa yang
# harus diisi selain membaca 5.800 baris generateQuizFromTopic.js.
#
# CARA PAKAI:
#   1. Salin file ini jadi `.env` untuk pengembangan lokal.
#   2. Untuk produksi, isi nilainya di dashboard Vercel:
#      Project -> Settings -> Environment Variables.
#   3. `.env` sudah masuk .gitignore. JANGAN PERNAH commit file berisi
#      nilai asli. File .env.example ini sengaja tidak berisi secret.
#
# Semua variabel di bawah dipakai HANYA di sisi server (api/*.js =
# Vercel Functions). Tidak ada secret AI yang dikirim ke browser —
# ini sudah diverifikasi saat audit.
#
# Yang bertanda [WAJIB] harus diisi agar fitur intinya jalan.
# Yang bertanda [opsional] punya nilai default di kode, atau hanya
# dipakai fitur tertentu.
# ============================================================


# ------------------------------------------------------------
# GEMINI (Google AI Studio) — [WAJIB]
# ------------------------------------------------------------
# Provider AI utama. Dipakai 6 endpoint: generateQuizFromTopic,
# extractPdfBankSoal, generateMateriSection, detectBookChapters,
# smartParseQuiz, generateGuruLearningAid.
# Ambil di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kunci KHUSUS beban soal (ekstraksi bank soal dari PDF, parse quiz,
# pembuat quiz). Opsional: bila kosong, beban soal jatuh ke GEMINI_API_KEY.
# CATATAN JUJUR: kuota gratis Gemini menempel pada PROYEK/akun Google,
# bukan pada nama kunci -- dua kunci dari akun yang sama berbagi satu
# kolam kuota. Pemisahan ini berguna untuk pemantauan pemakaian per
# fitur dan isolasi risiko (satu kunci bocor tidak mematikan semua),
# BUKAN untuk menambah jatah. Penambah tenaga gratis yang sungguhan:
# beda proyek/akun Google, atau fallback penyedia gratis (GROQ/
# OPENROUTER) yang sudah dirangkai di extractPdfBankSoal & konversiModulScan.
# Skema ini ditegakkan oleh api/kunciGemini.js (satu pintu pemilihan kunci).
GEMINI_SOAL=

# Endpoint & model untuk generateQuizFromTopic. Biarkan kosong untuk
# memakai default di bawah (sudah diisi sebagai komentar).
# Default AI_API_URL    = https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Default AI_MODEL      = gemini-3.6-flash
# Default AI_MODELS_URL = https://generativelanguage.googleapis.com/v1beta/openai/models
AI_API_URL=
AI_MODEL=
AI_MODELS_URL=


# ------------------------------------------------------------
# EXTRACT PDF BANK SOAL — [opsional]
# ------------------------------------------------------------
# Khusus api/extractPdfBankSoal.js. Bisa diarahkan ke provider lain
# tanpa mengubah kode. Default provider = 'gemini' (pakai GEMINI_API_KEY).
#
# BANKSOAL_AI_PROVIDER: 'gemini' | 'openai' | 'anthropic' | 'groq' | 'custom'
# BANKSOAL_AI_BASE_URL & BANKSOAL_AI_MODEL hanya perlu untuk 'custom'.
BANKSOAL_AI_PROVIDER=
BANKSOAL_AI_API_KEY=
BANKSOAL_AI_BASE_URL=
BANKSOAL_AI_MODEL=

# Provider cadangan untuk endpoint yang sama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=


# ------------------------------------------------------------
# GROQ — [opsional]
# ------------------------------------------------------------
# Dipakai api/konversiModulScan.js dan api/generateStudentNarrative.js.
# Default GROQ_MODEL = openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
# Daftar model tambahan, dipisah koma. Kalau kosong, kode memakai
# daftar bawaan (llama-4-scout, llama-4-maverick, llama-3.2-90b-vision).
GROQ_MODELS=


# ------------------------------------------------------------
# OPENROUTER — [opsional]
# ------------------------------------------------------------
# Provider cadangan untuk api/konversiModulScan.js.
OPENROUTER_API_KEY=
# Daftar model, dipisah koma. Kalau kosong, kode memakai daftar bawaan.
OPENROUTER_MODELS=


# ------------------------------------------------------------
# TAVILY — [opsional]
# ------------------------------------------------------------
# Pencarian web untuk api/generateQuizFromTopic.js.
TAVILY_API_KEY=


# ------------------------------------------------------------
# MIDTRANS — [WAJIB untuk pembayaran pendaftaran online]
# ------------------------------------------------------------
# Server Key (BUKAN Client Key) dari dashboard Midtrans.
# Dipakai api/create-payment.js.
# ⚠️ Ini secret tingkat tinggi: bisa membuat tagihan atas nama bimbel.
MIDTRANS_SERVER_KEY=


# ------------------------------------------------------------
# SUPABASE — [WAJIB untuk upload gambar bank soal]
# ------------------------------------------------------------
# Dipakai api/uploadBankSoalImages.js untuk menyimpan gambar soal.
# ⚠️ SERVICE ROLE KEY menembus semua Row Level Security. Jangan pernah
#    dipakai di kode frontend, jangan pernah di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# URL project Supabase, contoh: https://xyzcompany.supabase.co
# ⚠️ NAMANYA MENYESATKAN: prefiks NEXT_PUBLIC_ hanya bermakna di
#    Next.js. Repo ini Vite + Vercel Functions, dan variabel ini dibaca
#    di server. Nama dipertahankan supaya tidak memutus deploy yang
#    sudah berjalan — menggantinya harus dilakukan bersamaan di kode
#    (api/uploadBankSoalImages.js) dan di dashboard Vercel.
NEXT_PUBLIC_SUPABASE_URL=


# ------------------------------------------------------------
# FIREBASE ADMIN SDK — [WAJIB untuk api/verifyStaffLogin.js]
# ------------------------------------------------------------
# 🔥 BARU (perbaikan insiden Firestore terbuka): endpoint ini memindahkan
# verifikasi PIN Owner & password Admin ke SERVER, supaya browser tidak
# perlu lagi membaca `settings/global_config`. Itu prasyarat untuk bisa
# mengunci koleksi tersebut di Firestore Rules.
#
# Selama FIREBASE_SERVICE_ACCOUNT kosong, endpoint menjawab 501 dan klien
# otomatis memakai jalur lama — jadi memasang kodenya saja tidak memutus
# aplikasi yang sedang live.
#
# Cara mendapatkannya: Firebase Console -> Project settings -> Service
# accounts -> Generate new private key. Lihat docs/RUNBOOK-KEAMANAN.md.
#
# ⚠️ Service account = KUNCI MASTER seluruh database. Jangan pernah
#    di-commit. Simpan hanya di dashboard Vercel.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=gemilangsystem

# CATATAN BACKUP MINGGUAN: sejak Okt 2026 backup TIDAK lagi jadi function
# Vercel (build Vercel proyek ini mentok di 12 function -- lihat kepala
# scripts/backupFirestore.mjs). Backup kini jalan di GitHub Actions:
# secret FIREBASE_SERVICE_ACCOUNT juga perlu diisi di
# GitHub -> Settings -> Secrets and variables -> Actions.
# Tanpa secret itu, workflow backup melewati minggu itu dengan peringatan.


# ------------------------------------------------------------
# CATATAN: FIREBASE SISI KLIEN TIDAK PAKAI .env
# ------------------------------------------------------------
# Konfigurasi Firebase sisi KLIEN ada di src/firebase.js sebagai nilai tetap.
# Ini BUKAN kebocoran: apiKey Firebase web memang identifier publik,
# bukan secret — keamanan Firebase diatur lewat Security Rules dan
# domain yang diizinkan, bukan lewat kerahasiaan apiKey.
#
# Kalau nanti perlu lingkungan terpisah (development / staging /
# production), pindahkan blok firebaseConfig di src/firebase.js ke
# variabel VITE_FIREBASE_* dan daftarkan di sini.
